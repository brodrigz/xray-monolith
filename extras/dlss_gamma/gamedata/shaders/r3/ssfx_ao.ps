// Updated by Lvutner and Hippobot
#ifndef SSFX_READY
    #include "screenspace_common.h"
#endif

#include "settings_screenspace_AO.h"

// Internal values
uniform float4 ao_setup;
// Res, Intensity, -, Radius
uniform float4 ssfx_ao_setup2; // Distance, HUD, Flora, MaxOcc

float4x4 m_current; // Current projection matrix
float4x4 m_previous; // Previous projection matrix

Texture2D ssfx_ao;
Texture2D s_motion_vectors;
Texture2D s_prev_pos;
Texture2D jitter0;

sampler smp_jitter;

//Constants
float4 ogse_c_screen;

float calc_GTAO(float3 view_position, float3 view_normal, float2 texcoord, float2 jitter)
{
    const float GTAO_TAU = 6.2831854;    
    const float GTAO_HALF_PI = 1.5707964;

    int GTAO_DIRECTIONS = SSFX_AO_QUALITY / 2;
    int GTAO_STEPS = SSFX_AO_QUALITY;
    float GTAO_RADIUS = ao_setup.w;

    float GTAO_NEG_1_OVER_RADIUSQR = -1.0 / (GTAO_RADIUS * GTAO_RADIUS);

    view_position *= 0.9992;
    float3 view_direction = -normalize(view_position);

    float gtao_parameters = (screen_res.y) / (ogse_c_screen.z * 2.0); //projection scale
    gtao_parameters *= 0.5;

    float screen_radius = (GTAO_RADIUS * gtao_parameters) / view_position.z;

    float2 slice_scale = screen_radius * float2(screen_res.z, -screen_res.w);
    float slice_angle = GTAO_TAU / float(GTAO_DIRECTIONS);

    float2 occ_weight = (0.0).xx;

    for (int i = 0; i < GTAO_DIRECTIONS; i++)
    {
        float angle = (float(i) + jitter.x) * slice_angle;
        float3 slice_direction = float3(cos(angle), sin(angle), 0.0);

        float3 ortho_direction = slice_direction - view_direction * dot(slice_direction.xy, view_direction.xy);
        float3 axis = cross(slice_direction, view_direction);

        float3 proj_normal = view_normal - axis * dot(view_normal, axis);
        float proj_normal_length_rcp = rsqrt(dot(proj_normal, proj_normal));
        proj_normal *= proj_normal_length_rcp;

        float sin_n = dot(ortho_direction, -proj_normal);

        float max_horizon_cos = sin_n;

        for(int j = 0; j < GTAO_STEPS; j++)
        {
            float increment = (float(j) + jitter.y) / GTAO_STEPS;
            increment *= increment;

            float2 s_texcoord = texcoord.xy + slice_direction.xy * slice_scale.xy * increment;

            if(dot(s_texcoord - saturate(s_texcoord), 1.0) != 0.0)
                break;

            #ifndef USE_MSAA
                float3 gbuffer_data = s_position.Load(int3(s_texcoord * screen_res.xy, 0)).xyz;
            #else
                float3 gbuffer_data = s_position.Load(int3(s_texcoord * screen_res.xy, 0), 0).xyz;
            #endif

            float3 vs = gbuffer_data.z * float3((s_texcoord * screen_res.xy) * pos_decompression_params.zw - pos_decompression_params.xy, 1.0);
            float3 s_vector = vs - view_position;

            float s_vec_length = dot(s_vector, s_vector);
            float s_horizon = dot(s_vector, view_direction) * rsqrt(s_vec_length);
            float falloff = saturate(s_vec_length * GTAO_NEG_1_OVER_RADIUSQR + 1.0);

            s_horizon = lerp(-1.0, s_horizon, falloff);
            max_horizon_cos = max(max_horizon_cos, s_horizon);
        }
        max_horizon_cos = saturate(0.5 * sin(GTAO_HALF_PI * (1.0 + sin_n) - GTAO_HALF_PI * max_horizon_cos) + 0.5);

        occ_weight += float2(1.0 - max_horizon_cos, 1.0) * rcp(proj_normal_length_rcp);
    }
    occ_weight.x *= rcp(occ_weight.y);
    return saturate(1.0 - occ_weight.x * 2.0);
}


float4 main(p_screen I) : SV_Target
{
    // Scale TexCoor
    float2 tc = I.tc0.xy * ao_setup.x;
    float2 Pos2D = I.hpos.xy * ao_setup.x;

    // Sample position buffer
    #ifndef USE_MSAA
        float4 Pos = s_position.Sample( smp_nofilter, tc );
    #else
        float4 Pos = s_position.Load( int3( Pos2D, 0 ), 0 );
    #endif

    // Reconstruct Position, Normal and Material
    float3 P    = float3( Pos.z * ( Pos2D * pos_decompression_params.zw - pos_decompression_params.xy ), Pos.z );
    float3 N    = gbuf_unpack_normal( Pos.xy );
    //float mtl   = gbuf_unpack_mtl( Pos.w );

    // Rendering AO till ssfx_ao_setup2.x || Sky
    if (P.z >= ssfx_ao_setup2.x || P.z <= SKY_EPS)
        return float4(0,0,0,1);

    // Ao Noise
    float3 ao_noise = jitter0[uint2(I.hpos.xy)%64];
    ao_noise.xy = frac(ao_noise.xy + (timers.x*100.) * float2(0.245122333753, 0.430159709002));

    // MAT_FLORA from current pixel?????????
    bool mat_flora = false;//abs(mtl - MAT_FLORA) <= 0.04f;

    float4 Motion_Vectors = s_motion_vectors.Sample(smp_nofilter, tc);

    float WeaponFactor = Motion_Vectors.z;

    if (Motion_Vectors.w < -0.5)
        mat_flora = true;

    float HUD_Multiply = clamp(1.0 - WeaponFactor, ssfx_ao_setup2.y, 1.0f);

    // HIPPOBOT: Enabled GTAO implementation
    
    // Calc da high qual gtao
    float occ = calc_GTAO(P, N, tc, ao_noise.xy);
    
    // Apply Flora Mask
    if (mat_flora)
        occ = lerp(1.0, occ, ssfx_ao_setup2.z);

    // Apply HUD/Weapon Intensity Mask
    occ = lerp(1.0, occ, HUD_Multiply);

    // Apply Main Intensity
    occ = pow(occ, ao_setup.y * 1.0f);

    // Apply Distance Fadeout
    float Fadeoff = smoothstep(ssfx_ao_setup2.x * 0.7f, ssfx_ao_setup2.x, P.z);
    occ = saturate(occ + Fadeoff);

    float4 P4 = float4(P.xyz, 1.0);

    float4 p_current = mul(m_current, P4);

    float4 p_previous = mul(m_previous, P4);

    float2 current = p_current.xy / p_current.w;
    float2 previous = p_previous.xy / p_previous.w;

    // Reprojection UV
    float2 cam_rp = current.xy - previous.xy;
    cam_rp = float2(cam_rp.x, -cam_rp.y) * 0.5f;

    // Velocity
    float vel = length(Motion_Vectors.xy) * 10;

    // Without Camera MV
    float vel_history = length(Motion_Vectors.xy - cam_rp * (1.0f - WeaponFactor)) * 100;

    // HUD Mask
    if (WeaponFactor)
        vel_history *= 0.2f;

	float2 rnd = hash22(tc * 100 + timers.xx * 100) * 2.0f - 1.0f;
	rnd = rnd * (1.0f / screen_res.xy) * 0.25f;

	float2 full_tc = I.tc0.xy;
	float2 Rep_Tc = dlss_reproject((full_tc + rnd) - Motion_Vectors.xy);

	float4 prev = ssfx_ao.Sample(smp_rtlinear, clamp(Rep_Tc / ao_setup.x, 0.0f, float2(0.999f, 0.99f) / ao_setup.x));

	float4 prev_P = s_prev_pos.Sample(smp_rtlinear, Rep_Tc);

	float outoffsrc = any(Rep_Tc < 0) + any(Rep_Tc > 1.0f);
	outoffsrc = lerp(outoffsrc, prev.g, 0.9f);
    float docc = abs(1.0f - P.z / prev_P.z);

    docc *= 1.0f + 1.0f * WeaponFactor;

    // 0 Current frame ~ 1 Prev frame
    float weight = saturate(0.85f - (vel + outoffsrc + docc + prev.b));

    // Mix previous frames
    occ = lerp(occ, prev.w, weight);
    

    // Limit AO maximum occlusion
    occ = clamp(occ, ssfx_ao_setup2.w, 1.0f);

    // Disocclusion mask
    float docc_mask = saturate(docc - 0.05f);
    docc_mask = lerp((docc + vel + outoffsrc) * 10, prev.r, 0.95f);

    return saturate(float4(docc_mask, outoffsrc, lerp(vel_history, saturate(prev.b - 0.001f), 0.92f), occ));
}
